OPENAI_API_KEY=
# Replace every <YOUR_MODEL_NAME> tag with a model available from its provider.
# Each role reads its model identifier from the environment variables below.
GTP_MODEL_PROVIDER=openai
# Optional per-role overrides. Leave unset to use GTP_MODEL_PROVIDER.
# GTP_COORDINATOR_PROVIDER=ollama
# GTP_PLANNER_PROVIDER=ollama
# GTP_CHAT_PROVIDER=ollama
GTP_COORDINATOR_MODEL=<YOUR_MODEL_NAME>
GTP_PLANNER_MODEL=<YOUR_MODEL_NAME>
GTP_CHAT_MODEL=<YOUR_MODEL_NAME>
# Optional per-role response caps. Leave blank to use runtime defaults; set
# deployment-specific values only in ignored .env after observing usage.
GTP_COORDINATOR_MAX_OUTPUT_TOKENS=
GTP_PLANNER_MAX_OUTPUT_TOKENS=
GTP_CHAT_MAX_OUTPUT_TOKENS=
# Optional request-budget overrides; values belong in ignored .env or deploy
# environment. The global process cap is disabled when left blank.
GTP_TURN_LIMIT_PER_HOUR=
GTP_TURN_GLOBAL_LIMIT_PER_HOUR=
GTP_OPENAI_JSON_SCHEMA_MODELS=<YOUR_MODEL_NAME>
# When any OpenAI API error occurs, make one local Ollama attempt with this model.
# Per-role overrides may use a different local model if it is already served.
GTP_OLLAMA_FALLBACK_MODEL=<YOUR_MODEL_NAME>
# GTP_COORDINATOR_OLLAMA_FALLBACK_MODEL=<YOUR_MODEL_NAME>
# GTP_PLANNER_OLLAMA_FALLBACK_MODEL=<YOUR_MODEL_NAME>
# GTP_CHAT_OLLAMA_FALLBACK_MODEL=<YOUR_MODEL_NAME>
# Example mixed local configuration when Ollama is already serving a model:
# GTP_COORDINATOR_PROVIDER=openai
# GTP_PLANNER_PROVIDER=ollama
# GTP_CHAT_PROVIDER=ollama
# GTP_PLANNER_MODEL=<YOUR_MODEL_NAME>
# GTP_CHAT_MODEL=<YOUR_MODEL_NAME>
# To use Ollama for Coordinator too, set its provider to ollama and provide the
# model name that is already served locally.
# GTP_COORDINATOR_PROVIDER=ollama
# GTP_COORDINATOR_MODEL=<YOUR_MODEL_NAME>
# Direct host app endpoint; empty selects the ChatOllama provider default.
OLLAMA_BASE_URL=
# Compose app endpoint; empty selects http://host.docker.internal:11434.
# On Apple Silicon, that host endpoint lets native Ollama use the M1 GPU.
# Set http://ollama:11434 only for the opt-in CPU-only Compose ollama profile.
GTP_COMPOSE_OLLAMA_BASE_URL=
# Used only by the opt-in Compose ollama profile; whitespace-separated names.
OLLAMA_PULL_MODELS=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=
# Optional Compose ngrok profile. Keep the real token only in ignored .env.
NGROK_AUTHTOKEN=
# Local non-Compose fallback for explicitly saved tours.
GTP_SAVED_TOURS_DB_PATH=.local/saved_tours.sqlite
# Compose PostgreSQL database. Generate a unique password in the ignored .env.
GTP_SAVED_TOURS_POSTGRES_PASSWORD=
# PostgreSQL host directory. Keep outside the Git repository.
# GTP_DATA_DIR=../grounded-travel-planner-data
# Secure cookies default to true and Compose forces true. Set false only for
# direct local HTTP development without a TLS proxy.
GTP_SAVED_TOURS_COOKIE_SECURE=true
# Auth0 OIDC BFF. Use a separate Auth0 development application for local HTTP.
GTP_AUTH0_ISSUER=
GTP_AUTH0_CLIENT_ID=
GTP_AUTH0_CLIENT_SECRET=
# At least 32 random characters; never commit the real value.
GTP_AUTH_SESSION_SECRET=
# Public app origin, used to construct the exact Auth0 callback URL.
# GTP_AUTH_PUBLIC_ORIGIN=http://localhost:8503
# Local SQLite auth fallback. Compose should use the PostgreSQL archive database.
GTP_AUTH_DB_PATH=.local/auth.sqlite
