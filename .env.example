# Both agents use this model. Set actual credentials in an ignored .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional: an OpenAI-compatible endpoint that provides the requested model.
# OPENAI_BASE_URL=

TAVILY_API_KEY=

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=travel-planner
